@model MJ.Domain.ViewModels.PatternVM

<div class="modal fade" id="addPatternModal" tabindex="-1" aria-labelledby="patternModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title font-semibold" id="patternModalLabel">
                    @(Model.Id == 0 ? "Add New Pattern" : "Edit Pattern")
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="patternForm">
                    <input type="hidden" id="patternId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="patternName" class="form-label">Pattern Name</label>
                        <input type="text" id="patternName" value="@Model.Name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="patternDescription" class="form-label">Description</label>
                        <textarea id="patternDescription" rows="3" class="form-control" maxlength="100">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="patternStatus" id="patternActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="patternActive">Active</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="patternStatus" id="patternInactive" value="false" @(!Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="patternInactive">Inactive</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Pattern</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
