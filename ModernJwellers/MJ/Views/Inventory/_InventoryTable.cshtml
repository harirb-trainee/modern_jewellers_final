@model MJ.Domain.ViewModels.InventoryDashboardVM

<!-- Inventory Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="flex justify-between items-center p-4 border-b">
        <h2 class="text-lg font-semibold">Jewelry Items (@Model.TotalCount)</h2>
        <div class="flex items-center text-sm text-gray-500">
            <span class="mr-2">Items per page:</span>
            <select id="itemsPerPage"
                    class="border rounded-md px-2 py-1 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
        </div>
    </div>

    <div class="overflow-x-auto overflow-y-auto" style="max-height: 400px;">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0 z-10">
                <tr>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-10">
                        <input type="checkbox"
                               class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Item
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Category
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Polish
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Price
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Qty
                    </th>
                    <th scope="col"
                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody id="inventoryTableBody" class="bg-white divide-y divide-gray-200">
                @foreach (var item in Model.ItemList)
                {
                    <tr class="hover:bg-gray-50 transition-colors duration-150 cursor-pointer item-row" data-item-id="@item.ItemId">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <input type="checkbox"
                                   class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded">
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div class="h-10 w-10 flex-shrink-0">
                                    <img src="@(string.IsNullOrEmpty(item.PhotoUrl) ? "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=200" : item.PhotoUrl)"
                                         class="h-10 w-10 rounded-md object-cover shadow-sm border border-gray-100" alt="@item.ItemName" />
                                </div>
                                <div class="ml-4">
                                    <div class="text-sm font-medium text-gray-900">@item.ItemName</div>
                                    <div class="text-xs text-gray-500">@item.ItemId</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-50 text-blue-700">@item.CategoryName</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            @item.PolishType
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                            ₹@item.Item_price
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                                @(item.Item_Quantity < item.LowStockThreshold ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800")">
                                @item.Item_Quantity
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <div class="flex space-x-3">
                                <button class="text-blue-600 hover:text-blue-900 transition-colors" onclick="editItem('@item.ItemId')" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="text-red-600 hover:text-red-900 transition-colors" onclick="deleteItem('@item.ItemId')" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="bg-gray-50 px-4 py-3 border-t border-gray-200">
        <div class="flex items-center justify-between">
            <div class="text-sm text-gray-700">
                Showing <span class="font-medium">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span> to <span class="font-medium">@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</span> of <span class="font-medium">@Model.TotalCount</span> results
            </div>
            <div>
                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                    <button onclick="changePage(@(Model.CurrentPage - 1))" @(Model.CurrentPage <= 1 ? "disabled" : "")
                            class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.CurrentPage <= 1 ? "opacity-50 cursor-not-allowed" : "")">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <button onclick="changePage(@i)"
                                class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium @(Model.CurrentPage == i ? "text-blue-600 bg-blue-50 z-10 border-blue-500" : "text-gray-700 hover:bg-gray-50")">
                            @i
                        </button>
                    }

                    <button onclick="changePage(@(Model.CurrentPage + 1))" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")
                            class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.CurrentPage >= Model.TotalPages ? "opacity-50 cursor-not-allowed" : "")">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </nav>
            </div>
        </div>
    </div>
</div>
