@model MJ.Domain.ViewModels.ColorVM

<div class="modal fade" id="addColorModal" tabindex="-1" role="dialog" aria-labelledby="addColorModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-blue-600 text-white">
                <h5 class="modal-title font-bold" id="addColorModalLabel">@(Model.Id > 0 ? "Edit Color" : "Add New Color")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="colorForm">
                <div class="modal-body p-6">
                    <input type="hidden" id="colorId" value="@Model.Id" />
                    
                    <div class="mb-4">
                        <label for="colorName" class="block text-sm font-semibold text-gray-700 mb-1">Color Name</label>
                        <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 transition-200" id="colorName" value="@Model.Name" required placeholder="e.g. Yellow Gold, Rose Gold" />
                    </div>

                    <div class="mb-4">
                        <label for="hexCode" class="block text-sm font-semibold text-gray-700 mb-1">Color Preview (Hex Code)</label>
                        <div class="flex">
                            <input type="color" class="h-10 w-12 p-1 border border-gray-300 rounded-l-md" id="hexPicker" value="@(string.IsNullOrEmpty(Model.HexCode) ? "#000000" : Model.HexCode)" oninput="$('#hexCode').val(this.value)" />
                            <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-r-md focus:outline-none focus:ring-2 focus:ring-blue-500 transition-200" id="hexCode" value="@(Model.HexCode ?? "#000000")" placeholder="#000000" oninput="$('#hexPicker').val(this.value)" />
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Select a color or enter a hex code.</p>
                    </div>

                    <div class="mb-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Status</label>
                        <div class="flex items-center space-x-6">
                            <div class="flex items-center">
                                <input class="form-check-input h-4 w-4 text-blue-600 border-gray-300" type="radio" name="colorStatus" id="colorActive" value="true" @(Model.IsActive ? "checked" : "")>
                                <label class="ml-2 text-sm text-gray-700" for="colorActive">Active</label>
                            </div>
                            <div class="flex items-center">
                                <input class="form-check-input h-4 w-4 text-red-600 border-gray-300" type="radio" name="colorStatus" id="colorInactive" value="false" @(!Model.IsActive ? "checked" : "")>
                                <label class="ml-2 text-sm text-gray-700" for="colorInactive">Inactive</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-gray-50 border-t p-4">
                    <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-200" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-semibold shadow-sm transition-200">
                        @(Model.Id > 0 ? "Update Color" : "Save Color")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
