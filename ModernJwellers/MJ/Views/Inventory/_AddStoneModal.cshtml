@model MJ.Domain.ViewModels.StoneTypeVM

<div class="modal fade" id="addStoneModal" tabindex="-1" aria-labelledby="stoneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title font-semibold" id="stoneModalLabel">
                    @(Model.Id == 0 ? "Add New Stone Type" : "Edit Stone Type")
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="stoneForm">
                    <input type="hidden" id="stoneId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="stoneName" class="form-label">Stone Name</label>
                        <input type="text" id="stoneName" value="@Model.Name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="stoneDescription" class="form-label">Description</label>
                        <textarea id="stoneDescription" rows="3" class="form-control" maxlength="100">@Model.Description</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="stoneStatus" id="stoneActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="stoneActive">Active</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="stoneStatus" id="stoneInactive" value="false" @(!Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="stoneInactive">Inactive</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Stone Type</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
