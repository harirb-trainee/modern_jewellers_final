@model MJ.Domain.ViewModels.AddItemVM
<!-- Add Jewelry Item Modal -->
<div class="modal fade" id="addJewelryModal" tabindex="-1" aria-labelledby="addJewelryLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg rounded-3">

      <!-- Header -->
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-semibold" id="addJewelryLabel">@(Model?.MJCode != null ? "Edit Jewelry Item" : "Add New Jewelry Item")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body bg-white">
        <form id="addItemForm" class="row g-4">
          <input type="hidden" name="isEdit" value="@(Model?.MJCode != null ? "true" : "false")" />
          @if (Model?.MJCode != null)
          {
              <input type="hidden" name="MJCode" value="@Model.MJCode" />
          }

          <!-- Basic Information -->
          <div class="col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-light fw-semibold">Basic Information</div>
              <div class="card-body">

                <div class="mb-3">
                  <label for="itemName" class="form-label">Item Name</label>
                  <input type="text" id="itemName" name="ItemName" class="form-control" value="@Model?.ItemName" required>
                </div>

                <div class="mb-3">
                  <label for="itemSKU" class="form-label">MJ Code</label>
                  <input type="text" id="itemSKU" name="MJCode" class="form-control" value="@Model?.MJCode" @(Model?.MJCode != null ? "disabled" : "") required>
                </div>

                <div class="mb-3">
                  <label for="itemDescription" class="form-label">Description</label>
                  <textarea id="itemDescription" name="Description" rows="3" class="form-control">@Model?.Description</textarea>
                </div>

                <div class="mb-3">
                  <label for="itemCategory" class="form-label">Category</label>
                  <select id="itemCategory" name="Category" class="form-select">
                    <option value="">Select Category</option>
                    @if (ViewBag.CategoryList != null)
                    {
                        @foreach (var cat in ViewBag.CategoryList)
                        {
                            <option value="@cat.ProductHeadId" selected="@(Model?.Category == cat.ProductHeadId.ToString())">@cat.Name</option>
                        }
                    }
                  </select>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-light fw-semibold">Specifications</div>
              <div class="card-body">

                <div class="mb-3">
                  <label for="itemPolish" class="form-label">Polish Type</label>
                  <select id="itemPolish" name="PolishId" class="form-select">
                    <option value="">Select Polish</option>
                    @if (ViewBag.PolishList != null)
                    {
                        @foreach (var p in ViewBag.PolishList)
                        {
                            <option value="@p.PolishTypeId" selected="@(Model?.PolishId == p.PolishTypeId)">@p.Name</option>
                        }
                    }
                  </select>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-4">
                    <label for="patternType" class="form-label">Pattern Styles</label>
                    <select id="patternType" name="PatternId" class="form-select">
                        <option value="">Select Pattern</option>
                        @if (ViewBag.Patterns != null)
                        {
                            foreach (var pattern in ViewBag.Patterns)
                            {
                                <option value="@pattern.PatternId" selected="@(Model?.PatternId == pattern.PatternId)">@pattern.Name</option>
                            }
                        }
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label for="stoneType" class="form-label">Stone Type</label>
                    <select id="stoneType" name="StoneId" class="form-select">
                        <option value="">Select Stone</option>
                        @if (ViewBag.Stones != null)
                        {
                            foreach (var stone in ViewBag.Stones)
                            {
                                <option value="@stone.StoneTypeId" selected="@(Model?.StoneId == stone.StoneTypeId)">@stone.Name</option>
                            }
                        }
                    </select>
                  </div>
                  <div class="col-md-4">
                    <label for="fittingType" class="form-label">Fitting Type</label>
                    <select id="fittingType" name="FittingId" class="form-select">
                        <option value="">Select Fitting</option>
                        @if (ViewBag.Fittings != null)
                        {
                            foreach (var fitting in ViewBag.Fittings)
                            {
                                <option value="@fitting.FittingTypeId" selected="@(Model?.FittingId == fitting.FittingTypeId)">@fitting.Name</option>
                            }
                        }
                    </select>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="itemColor" class="form-label">Color</label>
                  <select id="itemColor" name="ColorId" class="form-select">
                    <option value="">Select Color</option>
                    @if (ViewBag.ColorList != null)
                    {
                        @foreach (var c in ViewBag.ColorList)
                        {
                            <option value="@c.ColorId" selected="@(Model?.ColorId == c.ColorId)">@c.Name</option>
                        }
                    }
                  </select>
                </div>

              </div>
            </div>
          </div>
          <!-- Pricing & Inventory -->
          <div class="col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-light fw-semibold">Pricing & Inventory</div>
              <div class="card-body">

                <div class="mb-3">
                  <label for="itemPrice" class="form-label">Price (₹)</label>
                  <input type="number" id="itemPrice" name="ItemPrice" min="0" step="1" class="form-control" value="@Model?.ItemPrice">
                </div>


                <div class="mb-3">
                  <label for="itemQuantity" class="form-label">Quantity</label>
                  <input type="number" id="itemQuantity" name="StockQuantity" min="0" class="form-control" value="@Model?.StockQuantity">
                </div>

                <div class="mb-3">
                  <label for="itemThreshold" class="form-label">Low Stock Threshold</label>
                  <input type="number" id="itemThreshold" name="ThreshHoldQuantity" min="1" value="@(Model?.ThreshHoldQuantity ?? 5)" class="form-control">
                </div>
              </div>
            </div>
          </div>


          <!-- Images & Attributes -->
          <div class="col-md-6">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-light fw-semibold">Images & Attributes</div>
              <div class="card-body">

                <div class="mb-3">
                  <label for="itemImage" class="form-label">Main Image</label>
                  <div class="d-flex align-items-center">
                    <div class="border rounded me-3" style="width:90px;height:90px;overflow:hidden;">
                      <img id="imagePreview" src="@(Model?.ItemImageUrl1 ?? "")" alt="Preview" class="w-100 h-100 object-fit-cover @(string.IsNullOrEmpty(Model?.ItemImageUrl1) ? "d-none" : "")">
                      <div id="imagePlaceholder"
                        class="d-flex justify-content-center align-items-center bg-light text-muted h-100 @(string.IsNullOrEmpty(Model?.ItemImageUrl1) ? "" : "d-none")">
                        <i class="fa-solid fa-image fa-lg"></i>
                      </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                      onclick="document.getElementById('imageUpload').click()">Upload</button>
                    <input id="imageUpload" name="ItemImage1" type="file" class="d-none" accept="image/*">
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Additional Images</label>
                  <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="document.getElementById('additionalImages').click()">
                    <i class="fa fa-plus"></i> Add Images
                  </button>
                  <input id="additionalImages" type="file" class="d-none" multiple accept="image/*">
                </div>
              </div>
            </div>
          </div>

        </form>
      </div>

      <!-- Footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="submit" form="addItemForm" class="btn btn-primary">Save Item</button>
      </div>

    </div>
  </div>
</div>
