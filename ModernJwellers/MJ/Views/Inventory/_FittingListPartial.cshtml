@model IEnumerable<FittingType>
<div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold">Fitting Types</h2>
    <button id="addFittingBtn" data-url="/Inventory/LoadAddFittingModal"
        class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 flex items-center">
        <i class="fas fa-plus mr-2"></i> Add Fitting Type
    </button>
</div>

<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @foreach (var item in Model)
            {
                <tr>
                    <td class="px-6 py-4">@item.Name</td>
                    <td class="px-6 py-4">@item.Description</td>
                    <td class="px-6 py-4">
                        <span class="px-2 inline-flex text-xs font-semibold rounded-full @(item.Status == true ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                            @(item.Status == true ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm font-medium">
                        <button class="text-blue-600 hover:text-blue-900 mr-3" onclick="editFitting(@item.FittingTypeId)">Edit</button>
                        <button class="text-red-600 hover:text-red-900" onclick="deleteFitting(@item.FittingTypeId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function editFitting(id) {
        $.get('/Inventory/LoadAddFittingModal?id=' + id, function (data) {
            $('#modalContainer').html(data);
            $('#addFittingModal').modal('show');
        });
    }
    function deleteFitting(id) {
        Swal.fire({
            title: "Are you sure?",
            text: "This fitting type will be removed!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Inventory/DeleteFitting/' + id,
                    type: 'DELETE',
                    success: function (res) {
                        if (res.success) {
                            toastr.success(res.message);
                            loadTab('fitting');
                        } else toastr.error(res.message);
                    }
                });
            }
        });
    }
</script>
